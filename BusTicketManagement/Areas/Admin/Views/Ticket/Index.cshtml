@model List<BusTicketManagement.Models.Ticket>

@{
    ViewData["Title"] = "Quản Lý Vé";
    var searchTerm = ViewBag.SearchTerm ?? "";
}

<div class="container-fluid mt-5">
    <h1 class="mb-4">🎫 Quản Lý Vé</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tìm kiếm -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" action="/Admin/Ticket/Index" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control" placeholder="Tìm theo Mã Vé, Email, SĐT hoặc Ghế..." value="@searchTerm">
                <button type="submit" class="btn btn-primary">🔍 Tìm</button>
                <a href="/Admin/Ticket/Index" class="btn btn-secondary">🔄 Reset</a>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Vé</th>
                        <th>Khách Hàng</th>
                        <th>SĐT</th>
                        <th>Tuyến</th>
                        <th>Ghế</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var ticket in Model)
                        {
                            var statusClass = ticket.Status switch
                            {
                                "Active" => "badge bg-success",
                                "Cancelled" => "badge bg-danger",
                                "Used" => "badge bg-info",
                                _ => "badge bg-secondary"
                            };

                            <tr>
                                <td>
                                    <strong>#@ticket.Id</strong>
                                </td>
                                <td>@ticket.User?.FullName</td>
                                <td>@ticket.User?.PhoneNumber</td>
                                <td>@ticket.Trip?.Route?.From → @ticket.Trip?.Route?.To</td>
                                <td><strong>@ticket.SeatNumber</strong></td>
                                <td><span class="@statusClass">@ticket.Status</span></td>
                                <td>@ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a href="/Admin/Ticket/Details/@ticket.Id" class="btn btn-sm btn-info">👁️ Chi tiết</a>
                                    @if (ticket.Status == "Active")
                                    {
                                        <form method="post" action="/Admin/Ticket/Cancel/@ticket.Id" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn chắc chắn muốn hủy vé này?')">×Hủy</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Không có vé nào khớp với tìm kiếm</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

