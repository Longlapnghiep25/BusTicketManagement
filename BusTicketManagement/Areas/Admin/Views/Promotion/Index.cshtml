@model List<BusTicketManagement.Models.Promotion>

@{
    ViewData["Title"] = "Quản Lý Mã Khuyến Mãi";
}

<div class="container-fluid mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🎁 Quản Lý Mã Khuyến Mãi</h1>
        <a href="/Admin/Promotion/Create" class="btn btn-primary btn-lg">➕ Thêm Mã</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Code</th>
                        <th>Mô Tả</th>
                        <th>Kiểu Giảm</th>
                        <th>Ngày Bắt Đầu</th>
                        <th>Ngày Kết Thúc</th>
                        <th>Trạng Thái</th>
                        <th>Đã Sử Dụng</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var promo in Model)
                        {
                            var status = (promo.IsActive && promo.EndDate > DateTime.UtcNow) ? "Hoạt Động" : "Tắt";
                            var statusClass = status == "Hoạt Động" ? "badge bg-success" : "badge bg-danger";

                            <tr>
                                <td><strong>@promo.Code</strong></td>
                                <td>@(promo.Description.Length > 40 ? promo.Description.Substring(0, 40) + "..." : promo.Description)</td>
                                <td>
                                    @if (promo.DiscountPercent > 0)
                                    {
                                        <span>-@promo.DiscountPercent%</span>
                                    }
                                    else
                                    {
                                        <span>-@promo.DiscountAmount.ToString("N0")đ</span>
                                    }
                                </td>
                                <td>@promo.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@promo.EndDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="@statusClass">@status</span></td>
                                <td>@promo.UsedCount/@(promo.UsageLimit == -1 ? "∞" : promo.UsageLimit)</td>
                                <td>
                                    <a href="/Admin/Promotion/Edit/@promo.Id" class="btn btn-sm btn-warning">✏️ Sửa</a>
                                    <a href="/Admin/Promotion/Delete/@promo.Id" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có mã khuyến mãi nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

