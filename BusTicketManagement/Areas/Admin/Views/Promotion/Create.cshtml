@model BusTicketManagement.Models.Promotion

@{
    ViewData["Title"] = "Thêm Mã Khuyến Mãi";
}

<div class="container mt-5 col-md-7">
    <h2 class="mb-4">➕ Thêm Mã Khuyến Mãi Mới</h2>

    <form method="post" action="/Admin/Promotion/Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="Code" class="form-label">Mã Code *</label>
            <input type="text" class="form-control" id="Code" name="Code" placeholder="VD: SUMMER2024" required>
        </div>

        <div class="mb-3">
            <label for="Description" class="form-label">Mô Tả</label>
            <textarea class="form-control" id="Description" name="Description" rows="2" placeholder="Mô tả chi tiết về khuyến mãi..."></textarea>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="DiscountPercent" class="form-label">Giảm Giá (%)</label>
                    <input type="number" class="form-control" id="DiscountPercent" name="DiscountPercent" placeholder="VD: 10" step="0.01" min="0">
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="DiscountAmount" class="form-label">Hoặc Giảm Giá (đ)</label>
                    <input type="number" class="form-control" id="DiscountAmount" name="DiscountAmount" placeholder="VD: 50000" step="1000" min="0">
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label for="MinOrderAmount" class="form-label">Đơn Hàng Tối Thiểu (đ)</label>
            <input type="number" class="form-control" id="MinOrderAmount" name="MinOrderAmount" placeholder="VD: 500000" step="1000" min="0">
        </div>

        <div class="mb-3">
            <label for="UsageLimit" class="form-label">Giới Hạn Sử Dụng (-1 = Vô Hạn)</label>
            <input type="number" class="form-control" id="UsageLimit" name="UsageLimit" value="-1" required>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="StartDate" class="form-label">Ngày Bắt Đầu *</label>
                    <input type="date" class="form-control" id="StartDate" name="StartDate" required>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="EndDate" class="form-label">Ngày Kết Thúc *</label>
                    <input type="date" class="form-control" id="EndDate" name="EndDate" required>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked>
                <label class="form-check-label" for="IsActive">
                    Kích hoạt ngay
                </label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">💾 Lưu</button>
            <a href="/Admin/Promotion" class="btn btn-secondary">❌ Hủy</a>
        </div>
    </form>
</div>

