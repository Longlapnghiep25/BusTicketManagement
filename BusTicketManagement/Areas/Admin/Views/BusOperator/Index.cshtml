@model List<BusTicketManagement.Models.BusOperator>

@{
    ViewData["Title"] = "Quản Lý Nhà Xe";
}

<div class="container-fluid mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🚌 Quản Lý Nhà Xe</h1>
        <a href="/Admin/BusOperator/Create" class="btn btn-primary btn-lg">➕ Thêm Nhà Xe</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên Nhà Xe</th>
                        <th>Hotline</th>
                        <th>Chính Sách</th>
                        <th>Ngày Tạo</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var op in Model)
                        {
                            <tr>
                                <td>@op.Id</td>
                                <td><strong>@op.Name</strong></td>
                                <td>@op.Hotline</td>
                                <td>@(op.Policy.Length > 50 ? op.Policy.Substring(0, 50) + "..." : op.Policy)</td>
                                <td>@op.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="/Admin/BusOperator/Edit/@op.Id" class="btn btn-sm btn-warning">✏️ Sửa</a>
                                    <a href="/Admin/BusOperator/Delete/@op.Id" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có nhà xe nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

