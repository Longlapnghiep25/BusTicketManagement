@model List<BusTicketManagement.Models.Trip>

@{
    ViewData["Title"] = "Quản Lý Chuyến Xe";
}

<div class="container-fluid mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🚌 Quản Lý Chuyến Xe</h1>
        <a href="/Admin/Trip/Create" class="btn btn-primary btn-lg">➕ Thêm Chuyến</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nhà Xe</th>
                        <th>Tuyến</th>
                        <th>Ngày Khởi Hành</th>
                        <th>Giá Vé</th>
                        <th>Tổng Ghế</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var trip in Model)
                        {
                            <tr>
                                <td>@trip.Id</td>
                                <td><strong>@trip.BusOperator?.Name</strong></td>
                                <td>@trip.Route?.From → @trip.Route?.To</td>
                                <td>@trip.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@trip.Price.ToString("N0")đ</td>
                                <td>@trip.TotalSeats</td>
                                <td>
                                    <a href="/Admin/Trip/Edit/@trip.Id" class="btn btn-sm btn-warning">✏️ Sửa</a>
                                    <a href="/Admin/Trip/Delete/@trip.Id" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có chuyến xe nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

