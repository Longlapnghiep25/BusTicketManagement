@model BusTicketManagement.Models.Route

@{
    ViewData["Title"] = "Thêm Tuyến Đường";
}

<div class="container mt-5 col-md-6">
    <h2 class="mb-4">➕ Thêm Tuyến Đường Mới</h2>

    <form method="post" action="/Admin/Route/Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="From" class="form-label">Điểm Đi *</label>
            <input type="text" class="form-control" id="From" name="From" placeholder="VD: Hà Nội" required>
        </div>

        <div class="mb-3">
            <label for="To" class="form-label">Điểm Đến *</label>
            <input type="text" class="form-control" id="To" name="To" placeholder="VD: Hồ Chí Minh" required>
        </div>

        <div class="mb-3">
            <label for="BaseDistance" class="form-label">Khoảng Cách (km)</label>
            <input type="number" class="form-control" id="BaseDistance" name="BaseDistance" placeholder="VD: 1700" step="0.01">
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">💾 Lưu</button>
            <a href="/Admin/Route" class="btn btn-secondary">❌ Hủy</a>
        </div>
    </form>
</div>

