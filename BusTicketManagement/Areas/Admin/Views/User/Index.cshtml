@model List<BusTicketManagement.Models.User>

@{
    ViewData["Title"] = "Quản Lý Người Dùng";
}

<div class="container-fluid mt-5">
    <h1 class="mb-4">👥 Quản Lý Người Dùng</h1>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Hạng Thành Viên</th>
                        <th>Điểm Tích Lũy</th>
                        <th>Ngày Tạo</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var user in Model)
                        {
                            var rankClass = user.Rank switch
                            {
                                "Gold" => "badge bg-warning text-dark",
                                "Silver" => "badge bg-secondary",
                                "Bronze" => "badge bg-danger",
                                _ => "badge bg-light"
                            };

                            <tr>
                                <td>@user.Id</td>
                                <td><strong>@user.FullName</strong></td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td><span class="@rankClass">@user.Rank</span></td>
                                <td>@user.Points pts</td>
                                <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="/Admin/User/Details/@user.Id" class="btn btn-sm btn-info">👁️ Chi tiết</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có người dùng nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

